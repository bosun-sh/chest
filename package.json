{
  "name": "@bosun-sh/chest",
  "version": "0.1.0",
  "description": "Local governance store for AI agent workflows.",
  "license": "Apache-2.0",
  "author": "bosun.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosun-sh/chest.git"
  },
  "bugs": {
    "url": "https://github.com/bosun-sh/chest/issues"
  },
  "homepage": "https://github.com/bosun-sh/chest#readme",
  "keywords": [
    "ai",
    "governance",
    "mcp",
    "ohtools",
    "workflow",
    "yaml"
  ],
  "engines": {
    "bun": ">=1.3.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ohtools": {
      "types": "./dist/ohtools.d.ts",
      "default": "./dist/ohtools.js"
    },
    "./cli": {
      "types": "./dist/workspace/cli-adapter.d.ts",
      "default": "./dist/workspace/cli-adapter.js"
    },
    "./mcp": {
      "types": "./dist/workspace/mcp-server.d.ts",
      "default": "./dist/workspace/mcp-server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test tests/unit/",
    "test:e2e": "bun test tests/e2e",
    "build": "bunx tsc -p tsconfig.build.json",
    "ci:lint": "bun run check && bun run typecheck",
    "ci:build": "bun run build && node scripts/npm-pack-dry-run.mjs",
    "ci:test": "bun test",
    "ci:precommit": "bun run ci:lint && bun run test:unit",
    "ci:premerge": "bun run ci:lint && bun run ci:test && bun run ci:build",
    "ci:prepush": "bun run ci:premerge",
    "pack:check": "node scripts/npm-pack-dry-run.mjs",
    "smoke:packed": "bun test tests/e2e/packed-artifact.test.ts",
    "release:check": "bun run ci:premerge",
    "release:dry-run": "bun run ci:premerge",
    "prepublishOnly": "bun run ci:premerge",
    "publish": "bun run ci:premerge && npm publish --ignore-scripts",
    "publish:npm": "npm publish --access public",
    "prepare": "husky",
    "prepack": "env TMPDIR=$(node -e \"process.stdout.write(require('node:os').tmpdir())\") XDG_CACHE_HOME=$(node -e \"process.stdout.write(require('node:os').tmpdir())\") BUN_INSTALL_CACHE_DIR=$(node -e \"process.stdout.write(require('node:os').tmpdir() + '/bun-cache')\") bun run build",
    "ohtools:list": "bunx ohtools --app ./src/ohtools.ts list",
    "ohtools:docs": "bunx ohtools --app ./src/ohtools.ts docs",
    "ohtools:graph": "bunx ohtools --app ./src/ohtools.ts graph"
  },
  "dependencies": {
    "@bosun-sh/ohtools": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.13.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
